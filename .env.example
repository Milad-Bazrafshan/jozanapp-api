POSTGRES_DB=orix_school
POSTGRES_USER=orix_school
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
API_PORT=8080
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
JWT_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
EXPOSE_PASSWORD_RESET_TOKEN=true
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_TENANT_NAME=آموزشگاه نمونه
BOOTSTRAP_TENANT_SLUG=demo-school
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-now
DEMO_DATA_ENABLED=true
DEMO_DATA_PASSWORD=change-me-now
